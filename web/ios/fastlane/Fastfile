# Dispax iOS — fastlane
#
# This lane uploads an already-built IPA to TestFlight. The IPA itself is
# produced by Flutter (`make flutter-prod-ios` -> `flutter build ipa`), so the
# signing / dart-define wiring stays in one place (the Makefile) and fastlane is
# responsible only for authentication + upload.
#
# Authentication uses an App Store Connect API key (no Apple ID password / 2FA),
# which is what CI needs. Create the key at:
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API
# then provide these environment variables (locally via `.env` or in CI secrets):
#   ASC_KEY_ID        the Key ID (e.g. "2X9R4HXF34")
#   ASC_ISSUER_ID     the Issuer ID (a UUID shown on the same page)
#   ASC_KEY_CONTENT   the full contents of the downloaded AuthKey_XXXX.p8 file
#                     (paste the PEM text, including the BEGIN/END lines)
#
# The IPA path defaults to the Flutter output location and can be overridden:
#   fastlane beta ipa:/absolute/path/to/App.ipa

default_platform(:ios)

DEFAULT_IPA_PATH = File.expand_path("../../build/ios/ipa/dispax.ipa", __dir__)

# Flutter names the IPA after the pubspec `name` (dispax.ipa), but fall back to
# whatever single IPA exists in the output dir so a renamed archive still works.
# Defined at the top level (not inside the platform block) so it resolves
# reliably in fastlane's instance_eval DSL context.
def first_existing_ipa
  return DEFAULT_IPA_PATH if File.exist?(DEFAULT_IPA_PATH)

  dir = File.dirname(DEFAULT_IPA_PATH)
  candidates = Dir.glob(File.join(dir, "*.ipa"))
  UI.user_error!("No IPA found in #{dir}. Run `make flutter-prod-ios` first.") if candidates.empty?
  candidates.first
end

APP_IDENTIFIER = "de.dispax.app"
TEAM_ID = "D74H38HXXR"
MATCH_PROFILE_NAME = "match AppStore #{APP_IDENTIFIER}"

# Build an App Store Connect API key object from env vars (no Apple ID / 2FA).
# Defined at the top level so both lanes can reuse it.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  desc "Upload an already-built IPA to TestFlight (local: build with `make flutter-prod-ios` first)"
  lane :beta do |options|
    ipa_path = options[:ipa] || first_existing_ipa

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "CI: fetch signing via match, build a manually-signed IPA, upload to TestFlight"
  lane :ci_beta do
    # 1. Pull the shared distribution cert + profile from the GCS bucket.
    #    readonly: CI never mutates the Apple account (the bucket is seeded once
    #    by a human via `fastlane match appstore`).
    match(
      type: "appstore",
      readonly: true,
      api_key: asc_api_key
    )

    # 2. Flip the project to manual signing on THIS checkout only (the committed
    #    project stays on Automatic for local dev). Without this, the archive
    #    step fails on a headless runner with "No profiles for 'de.dispax.app'"
    #    before export options ever apply.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: MATCH_PROFILE_NAME,
      bundle_identifier: APP_IDENTIFIER,
      targets: ["Runner"]
    )

    # 3. Build the signed IPA via Flutter (keeps --dart-define wiring intact —
    #    API_BASE_URL and MAPBOX_ACCESS_TOKEN come from the CI env). Run from the
    #    Flutter root (web/), one level up from ios/.
    prod_url = ENV.fetch("PROD_URL", "https://dispax-o2trzxjbva-ew.a.run.app")
    mapbox = ENV.fetch("MAPBOX_ACCESS_TOKEN")
    UI.user_error!("MAPBOX_ACCESS_TOKEN is empty — maps would ship broken") if mapbox.strip.empty?

    # App Store Connect rejects a duplicate (version, build) pair, so every upload
    # needs a strictly higher build number. GITHUB_RUN_NUMBER increases across runs
    # of the same workflow — and, unlike the Makefile's `git rev-list --count`, it
    # does not depend on clone depth (actions/checkout is shallow by default).
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")

    Dir.chdir("..") do
      sh(
        "flutter", "build", "ipa", "--release",
        "--build-number=#{build_number}",
        "--export-options-plist=ios/ExportOptions.plist",
        "--dart-define=API_BASE_URL=#{prod_url}/api",
        "--dart-define=MAPBOX_ACCESS_TOKEN=#{mapbox}"
      )
    end

    # 4. Upload the resulting IPA to TestFlight.
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: first_existing_ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
