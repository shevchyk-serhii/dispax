# Copy to web/ios/.env and fill in with your App Store Connect API key.
# NEVER commit the filled-in .env — it is gitignored.
#
# Create the key at: App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API. Download AuthKey_XXXXXXXXXX.p8 (offered only once).

# Key ID, shown next to the key (e.g. 2X9R4HXF34).
ASC_KEY_ID=

# Issuer ID (a UUID shown at the top of the Integrations page).
ASC_ISSUER_ID=

# Full contents of the .p8 file, including the -----BEGIN/END PRIVATE KEY----- lines.
# For a multi-line value in a .env file, wrap it in double quotes and keep the newlines,
# or paste it as one line with \n separators. In CI, store it as a secret instead.
ASC_KEY_CONTENT=
