        flightNumber = None,
        isAirportTransfer = false
      )
      
      val response = createRideRequest("POST", "/api/rides", Some(request.toJson))
      assumeResponseStatus(response, Status.Created)
      
      val rideJson = response.body.asString.fromJson[Map[String, Any]].getOrElse(Map.empty)
      rideJson.get("id").map(_.toString.toLong).getOrElse(0L)
