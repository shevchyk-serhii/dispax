      scheduledTime = None,
      notes = None,
      airportCode = None,
      flightNumber = None,
      isAirportTransfer = true
    )
  }

  Given("^the pickup location is \"([^\"]+)\"$") { (location: String) =>
    currentRideRequest = currentRideRequest.copy(
      pickupLocation = Location(location)
