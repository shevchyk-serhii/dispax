  }

  Given("^the dropoff location is \"([^\"]+)\"$") { (location: String) =>
    currentRideRequest = currentRideRequest.copy(
      dropoffLocation = Location(location)
    )
  }

  Given("^the airport code is \"([^\"]+)\"$") { (code: String) =>
    currentRideRequest = currentRideRequest.copy(airportCode = Some(code))
  }

  Given("^the flight number is \"([^\"]+)\"$") { (flightNumber: String) =>
    currentRideRequest = currentRideRequest.copy(flightNumber = Some(flightNumber))
  }

  Given("^I want to create a ride with invalid data$") { () =>
    // Will be configured in subsequent steps
    currentRideRequest = CreateRideRequest(
      clientId = PersonId(testUserId),
      pickupLocation = Location(""),
      dropoffLocation = Location(""),
      scheduledTime = None,
      notes = None,
