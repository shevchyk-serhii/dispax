package com.shevchyk.steps

import com.shevchyk.ride.domain.{CreateRideRequest, RideStatus, UpdateRideStatusRequest}
import com.shevchyk.core.domain.{Location, PersonId}
import io.cucumber.scala.{EN, ScalaDsl}
import zio.*
import zio.http.*
import zio.json.*
import java.time.{Instant, LocalDateTime, ZoneOffset}

class RideManagementSteps extends ScalaDsl with EN with ApiTestHelpers {

  var currentRideRequest: CreateRideRequest = _
  var lastRideResponse: Response = _
  var lastRideId: Option[Long] = None
  var createdRideIds: List[Long] = List.empty
  var testUserId: Long = 1L
  var testDriverId: Long = 2L

  Given("^I want to create a ride from \"([^\"]+)\" to \"([^\"]+)\"$") { (pickup: String, dropoff: String) =>
    currentRideRequest = CreateRideRequest(
      clientId = PersonId(testUserId),
      pickupLocation = Location(pickup),
      dropoffLocation = Location(dropoff),
      scheduledTime = None,
      notes = None,
      airportCode = None,
      flightNumber = None,
      isAirportTransfer = false
    )
  }

  Given("^the pickup time is scheduled for tomorrow at (\\d+):(\\d+) (AM|PM)$") { (hour: Int, minute: Int, ampm: String) =>
    val adjustedHour = if (ampm == "PM" && hour != 12) hour + 12 else if (ampm == "AM" && hour == 12) 0 else hour
    val tomorrow = LocalDateTime.now().plusDays(1).withHour(adjustedHour).withMinute(minute).withSecond(0)
    val scheduledTime = tomorrow.toInstant(ZoneOffset.UTC)
    
    currentRideRequest = currentRideRequest.copy(scheduledTime = Some(scheduledTime))
  }

  Given("^the pickup time is scheduled for today at (\\d+):(\\d+) (PM)$") { (hour: Int, minute: Int, ampm: String) =>
    val adjustedHour = if (ampm == "PM" && hour != 12) hour + 12 else hour
    val today = LocalDateTime.now().withHour(adjustedHour).withMinute(minute).withSecond(0)
    val scheduledTime = today.toInstant(ZoneOffset.UTC)
    
    currentRideRequest = currentRideRequest.copy(scheduledTime = Some(scheduledTime))
  }

  Given("^the pickup time is scheduled for yesterday$") { () =>
    val yesterday = Instant.now().minusSeconds(86400) // 24 hours ago
    currentRideRequest = currentRideRequest.copy(scheduledTime = Some(yesterday))
  }

  Given("^I add a note \"([^\"]+)\"$") { (note: String) =>
    currentRideRequest = currentRideRequest.copy(notes = Some(note))
  }

  Given("^I want to create an airport transfer ride$") { () =>
    currentRideRequest = CreateRideRequest(
