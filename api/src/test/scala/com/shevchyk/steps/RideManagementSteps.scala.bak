  }

  Given("^I have created a ride with ID (\\d+)$") { (rideId: Long) =>
    lastRideId = Some(rideId)
    // For test purposes, we'll assume this ride exists in our mock data
  }

  Given("^another user has created a ride with ID (\\d+)$") { (rideId: Long) =>
    // This ride belongs to a different user - we'll simulate this in our test
  }

  Given("^I am logged in as a driver$") { () =>
    currentToken = Some("driver-token") // Switch to driver token
    testUserId = testDriverId
  }

  Given("^there is an assigned ride with ID (\\d+)$") { (rideId: Long) =>
    lastRideId = Some(rideId)
  }

  Given("^I am the assigned driver for this ride$") { () =>
    // This is assumed for test purposes
  }

  Given("^there is a ride with status \"([^\"]+)\"$") { (status: String) =>
    // This is assumed for test purposes
  }

  When("^I submit the ride creation request$") { () =>
    lastRideResponse = createRideRequest("POST", "/api/rides", Some(currentRideRequest.toJson))
  }

  When("^I request to view my rides$") { () =>
    lastRideResponse = createRideRequest("GET", "/api/rides", None)
  }

  When("^I request ride details for ride ID (\\d+)$") { (rideId: Long) =>
