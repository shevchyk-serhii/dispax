<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Forward WARN+ logs to Sentry. The SDK is configured via env (SENTRY_DSN,
       SENTRY_ENVIRONMENT, SENTRY_RELEASE) and is a no-op when SENTRY_DSN is unset,
       so this is inert in local/dev without any extra guards. minimumEventLevel
       controls what becomes a Sentry issue; breadcrumbs capture surrounding INFO. -->
  <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
    <minimumEventLevel>WARN</minimumEventLevel>
    <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
  </appender>

  <logger name="sun.rmi" level="ERROR" />
  <logger name="java.rmi" level="ERROR" />
  <logger name="sun.rmi.transport.tcp" level="ERROR" />

  <!-- Quiet routine framework noise. The root is INFO (was DEBUG) because the
       biggest offender, "ReadTimeoutException caught", is emitted via
       ZIO.logDebug from zio-http's NettyConnectionPool$ReadTimeoutErrorHandler
       when an idle outbound keep-alive connection is reaped by Netty's read
       timeout — routine cleanup, not an error. Netty/Hikari/Postgres dump
       verbose DEBUG on startup (PlatformDependent probes, HikariConfig), so pin
       them at WARN; keep Flyway at INFO so migration progress stays visible.
       Mirrors logback-test.xml. App logs stay at INFO via root. -->
  <logger name="io.netty" level="WARN" />
  <logger name="com.zaxxer.hikari" level="WARN" />
  <logger name="org.postgresql" level="WARN" />
  <logger name="org.flywaydb" level="INFO" />

  <root level="INFO">
    <appender-ref ref="STDOUT" />
    <appender-ref ref="SENTRY" />
  </root>
</configuration>