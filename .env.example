# Copy to .env.dev and fill in values for local development
DATABASE_URL=jdbc:postgresql://localhost:5432/dispax
DATABASE_USER=dispax
DATABASE_PASSWORD=dispax
JWT_SECRET=dev-secret-change-in-production
APP_ENV=development
PORT=8080

# Flutter devices for dev-all / flutter-dev-sergii
# Find device IDs with: flutter devices
FLUTTER_DEVICE_IPHONE_SERGII=<iphone-udid>
FLUTTER_DEVICE_ANDROID_SERGII=<android-ip:port>
