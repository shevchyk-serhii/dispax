# APP_ENV is the single environment selector: development | test | production.
# The backend derives the HOCON profile (application-<APP_ENV>.conf) from it, so
# no -Dconfig.resource flag is needed — `make dev` / `make run-test` just work.

# ── Development (.env.dev) — copy this file to .env.dev and fill in values ────
DATABASE_URL=jdbc:postgresql://localhost:5432/dispax
DATABASE_USER=dispax
DATABASE_PASSWORD=dispax
JWT_SECRET=dev-secret-change-in-production
APP_ENV=development
PORT=8080

# Flutter devices for dev-all / flutter-dev-sergii
# Find device IDs with: flutter devices
FLUTTER_DEVICE_IPHONE_SERGII=<iphone-udid>
FLUTTER_DEVICE_ANDROID_SERGII=<android-ip:port>

# ── Test (.env.test) — full backend against the isolated postgres-test DB ─────
# Start the DB first: docker compose up -d postgres-test ; then: make run-test
# DATABASE_URL=jdbc:postgresql://localhost:5433/dispax_test
# DATABASE_USER=dispax
# DATABASE_PASSWORD=dispax
# JWT_SECRET=dev-secret-change-in-production
# APP_ENV=test
# PORT=8090

# SMTP (MailHog / GreenMail for local dev; replace with real SMTP provider for production)
# Dev default: port 1025 = MailHog SMTP port (no auth required)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@dispax.de
SMTP_REPLY_TO=support@dispax.de
SMTP_STARTTLS=false

# ── Production — set these as env vars in Cloud Run (never commit real values) ─
# APP_ENV=production
# DATABASE_URL / DATABASE_USER / DATABASE_PASSWORD — managed in the Cloud Run service
# JWT_SECRET — required in production (the app refuses to start without it)
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_FROM — required in production
