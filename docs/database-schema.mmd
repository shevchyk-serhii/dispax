    tariffs ||--o{ rides : ""
    schedule_days ||--o{ rides : ""
    ride_pools ||--o{ rides : ""
    rides ||--o{ invoice_items : ""

    companies ||--o{ ride_templates : ""
    persons ||--o{ ride_templates : "client"
    ride_pools ||--o{ ride_pool_members : ""
    rides ||--o| ride_ratings : ""
    rides ||--|| client_locations : ""
    rides ||--o{ chat_messages : ""
    rides ||--o{ expenses : ""
    rides ||--o{ emergency_reassignments : ""
