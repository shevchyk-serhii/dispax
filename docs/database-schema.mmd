    companies ||--o{ geofences : ""
    geofences ||--o{ geofence_alerts : ""
    persons ||--o{ geofence_alerts : "driver"
    companies ||--o{ blacklist_entries : ""
    persons ||--o{ blacklist_entries : "client"
    persons ||--o{ client_addresses : ""

    airports ||--o{ airport_checkpoint_zones : ""

