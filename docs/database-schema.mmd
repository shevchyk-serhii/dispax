erDiagram
    %% Source of truth for the ER diagram. Regenerate database-schema.png / .svg from this file
    %% (e.g. `mmdc -i database-schema.mmd -o database-schema.svg`) after changing it.
    %% ===== Core / multitenancy =====
    companies {
        UUID id PK
        VARCHAR name
        VARCHAR email
        VARCHAR phone
        TEXT address
    }
    client_companies {
        UUID id PK
        VARCHAR name
        UUID taxi_company_id FK
    }
    persons {
        UUID id PK
        VARCHAR name
        VARCHAR email UK
        enum role
        UUID company_id FK
        UUID client_company_id FK
        VARCHAR password_hash
        UUID preferred_driver_id FK
        BOOLEAN is_vip
        VARCHAR status
        INT reminder_minutes
    }
    drivers {
        UUID id PK
        UUID company_id FK
        enum status
        DOUBLE current_location_lat
        DOUBLE current_location_lng
    }

    %% ===== Auth / sessions =====
    tokens {
        VARCHAR token PK
        UUID user_id FK
    }
    sessions {
        UUID id PK
        UUID user_id FK
        TEXT token
        BOOLEAN is_active
    }
    fcm_tokens {
        UUID person_id FK
        TEXT token UK
        VARCHAR platform
    }
    gdpr_consents {
        UUID id PK
        UUID user_id FK
        VARCHAR consent_type
    }
    gdpr_requests {
        UUID id PK
        UUID user_id FK
        VARCHAR request_type
        VARCHAR status
    }

    %% ===== Schedule =====
    schedule_days {
        UUID id PK
        UUID driver_id FK
        UUID company_id FK
        DATE date
        TIME start_time
        TIME end_time
        enum status
    }

    %% ===== Billing =====
    tariffs {
        UUID company_id PK
        DECIMAL base_price_amount
        DECIMAL price_per_km_amount
    }
    invoice_sequences {
        UUID company_id PK
        INT last_number
    }
    invoices {
        UUID id PK
        VARCHAR number
        UUID client_company_id FK
        UUID taxi_company_id FK
        VARCHAR status
        DECIMAL total_amount
    }
    invoice_items {
        UUID id PK
        UUID invoice_id FK
        UUID ride_id FK
        DECIMAL total
    }

    %% ===== Rides =====
    rides {
        UUID id PK
        UUID client_id FK
        UUID creator_id FK
        UUID driver_id FK
        UUID company_id FK
        UUID invoice_id FK
        UUID tariff_id FK
        UUID schedule_day_id FK
        UUID pool_id FK
        VARCHAR from_address
        VARCHAR to_address
        TIMESTAMPTZ pickup_datetime
        enum status
        enum payment_status
        JSONB specifics
    }
    ride_templates {
        UUID id PK
        UUID company_id FK
        UUID client_id FK
        UUID creator_id FK
        UUID preferred_driver_id FK
        VARCHAR recurrence_pattern
    }
    ride_pools {
        UUID id PK
        UUID company_id
        UUID driver_id
        VARCHAR status
        INT max_passengers
    }
    ride_pool_members {
        UUID id PK
        UUID pool_id FK
        UUID ride_id
        UUID client_id
        INT pickup_order
    }
    ride_ratings {
        UUID id PK
        UUID ride_id FK
        UUID client_id FK
        UUID driver_id FK
        INT rating
    }
    client_locations {
        UUID ride_id PK
        UUID client_id FK
        DOUBLE latitude
        DOUBLE longitude
    }
    chat_messages {
        UUID id PK
        UUID ride_id FK
        UUID sender_id FK
        TEXT message
    }
    expenses {
        UUID id PK
        UUID ride_id FK
        UUID driver_id FK
        UUID company_id FK
        DECIMAL amount
    }
    emergency_reassignments {
        UUID id PK
        UUID ride_id FK
        UUID original_driver_id FK
        UUID new_driver_id FK
        UUID reassigned_by FK
    }
    sent_reminders {
        UUID ride_id PK
        UUID person_id PK
        TIMESTAMPTZ sent_at
    }

    %% ===== Misc =====
    company_settings {
        UUID company_id PK
        DECIMAL commission_rate
        BOOLEAN auto_assign_enabled
    }
    notifications {
        UUID id PK
        UUID person_id FK
        UUID company_id FK
        VARCHAR type
        BOOLEAN is_read
    }
    notification_preferences {
        UUID id PK
        UUID person_id UK
        BOOLEAN ride_updates
        BOOLEAN chat_messages
    }
    audit_log {
        UUID id PK
        UUID company_id FK
        UUID actor_id FK
        VARCHAR action
        VARCHAR entity_type
        UUID entity_id
    }
    geofences {
        UUID id PK
        UUID company_id FK
        VARCHAR geofence_type
        INT radius_meters
    }
    geofence_alerts {
        UUID id PK
        UUID geofence_id FK
        UUID driver_id FK
        UUID company_id FK
        VARCHAR alert_type
    }
    blacklist_entries {
        UUID id PK
        UUID company_id FK
        UUID client_id FK
        UUID driver_id FK
        UUID created_by FK
    }
    client_addresses {
        UUID id PK
        UUID client_id FK
        VARCHAR label
        TEXT address
    }

    %% ===== Airports (global, cross-tenant) =====
    airports {
        VARCHAR code PK
        VARCHAR name
        VARCHAR country
        DOUBLE landing_lat
        DOUBLE landing_lon
        INT landing_radius
        BOOLEAN is_active
    }
    airport_checkpoint_zones {
        UUID id PK
        VARCHAR airport_code FK
        VARCHAR terminal_code
        VARCHAR checkpoint_type
        VARCHAR display_name
        DOUBLE lat
        DOUBLE lon
        INT radius_meters
    }

    %% ===== Schedule (visibility / unavailability) =====
    driver_schedule_visibility {
        UUID driver_id PK
        UUID company_id FK
        BOOLEAN can_view_other_schedules
    }
    driver_unavailability {
        UUID id PK
        UUID driver_id FK
        UUID company_id FK
        TIMESTAMPTZ from_time
        TIMESTAMPTZ to_time
        enum reason
        TEXT note
    }

    %% ===== Partner / external hand-off =====
    partner_companies {
        UUID id PK
        VARCHAR name
        VARCHAR email
        VARCHAR phone
        UUID taxi_company_id FK
    }
    external_drivers {
        UUID id PK
        VARCHAR name
        VARCHAR phone
        UUID partner_company_id FK
        UUID taxi_company_id FK
    }

    %% ===== Guest tracking =====
    ride_share_tokens {
        UUID id PK
        VARCHAR token UK
        UUID ride_id FK
        UUID company_id
        TIMESTAMPTZ expires_at
    }

    %% ===== Billing profile / booking reference =====
    company_billing_profile {
        UUID company_id PK
        VARCHAR legal_name
        VARCHAR vat_id
        VARCHAR iban
        INT payment_terms_days
    }
    booking_reference_sequences {
        UUID company_id PK
        INT last_number
    }

    %% ===== Calendar sharing =====
    calendar_share_invites {
        UUID id PK
        VARCHAR token UK
        UUID grantor_person_id FK
        UUID grantor_company_id FK
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ revoked_at
    }
    calendar_share_grants {
        UUID id PK
        UUID invite_id FK
        UUID grantor_person_id FK
        UUID grantor_company_id FK
        UUID grantee_person_id FK
        UUID grantee_company_id FK
        TIMESTAMPTZ revoked_at
    }

    %% ===== Notification idempotency =====
    sent_checkpoint_notifications {
        UUID ride_id PK
        UUID driver_id PK
        VARCHAR checkpoint_type PK
        TIMESTAMPTZ sent_at
    }
    eta_alerts {
        UUID ride_id PK
        UUID driver_id PK
        TIMESTAMPTZ alerted_at
    }
    sent_confirmation_requests {
        UUID ride_id PK
        UUID person_id PK
        TIMESTAMPTZ sent_at
    }

    %% ===== Relations =====
    companies ||--o{ client_companies : "obsluzhivaet"
    companies ||--o{ persons : "rabotniki"
    client_companies ||--o{ persons : "kontakty"
    persons ||--o| persons : "preferred_driver"
    persons ||--|| drivers : "profil_voditelya"
    companies ||--o{ drivers : ""

    persons ||--o{ tokens : ""
    persons ||--o{ sessions : ""
