    persons ||--o{ sent_reminders : ""

    companies ||--|| company_settings : ""
    persons ||--o{ notifications : ""
    companies ||--o{ notifications : ""
    persons ||--o| notification_preferences : ""
    companies ||--o{ audit_log : ""
